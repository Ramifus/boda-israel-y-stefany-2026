    <!-- 🎬 ANIMACIONES CON GSAP                                     -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        if (typeof window !== "undefined") {
            document.addEventListener("DOMContentLoaded", () => {
                const tl = gsap.timeline({
                    scrollTrigger: {
                        trigger: "#card-confirmar",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                });

                tl.fromTo(
                    "#boton-decorativo-confirmar",
                    { opacity: 0, scale: 0, rotation: -180 },
                    {
                        opacity: 1,
                        scale: 1,
                        rotation: 0,
                        duration: 1,
                        ease: "back.out(1.7)",
                    },
                    0,
                )
                    .fromTo(
                        "#card-principal-confirmar",
                        { opacity: 0, y: 50, scale: 0.95 },
                        {
                            opacity: 1,
                            y: 0,
                            scale: 1,
                            duration: 1,
                            ease: "power3.out",
                        },
                        0,
                    )
                    .fromTo(
                        "#titulo-confirmar",
                        { opacity: 0, y: -15 },
                        { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" },
                        0.4,
                    )
                    .fromTo(
                        "#linea-conf-1, #texto-personal, #linea-conf-2",
                        { opacity: 0, y: 10 },
                        { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" },
                        0.55,
                    )
                    .fromTo(
                        "#texto-honesto",
                        { opacity: 0, y: 15 },
                        { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" },
                        0.7,
                    )
                    .fromTo(
                        "#linea-conf-3, #mensaje-final-conf",
                        { opacity: 0, y: 15 },
                        { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" },
                        0.85,
                    )
                    .fromTo(
                        "#botones-confirmar",
                        { opacity: 0, y: 20, scale: 0.95 },
                        {
                            opacity: 1,
                            y: 0,
                            scale: 1,
                            duration: 0.7,
                            ease: "back.out(1.3)",
                        },
                        1,
                    );

                gsap.to("#boton-decorativo-confirmar", {
                    y: -5,
                    duration: 2,
                    ease: "sine.inOut",
                    yoyo: true,
                    repeat: -1,
                    delay: 1.2,
                });
            });
        }
    </script>

