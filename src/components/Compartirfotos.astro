<!-- ═══════════════════════════════════════════════════════════ --><!-- 📸 SECCIÓN: COMPARTE TUS FOTOS                             --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-10 pb-10 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- 📇 CARD DE COMPARTIR FOTOS -->
        <div class="flex justify-center">
            <div class="relative w-[300px]" id="card-fotos">
                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div class="w-16 h-16" id="boton-decorativo-fotos">
                        <img
                            src="/imagenes/boton.png"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-[40px] shadow-xl overflow-hidden bg-[#f5f5f5]"
                    id="card-principal-fotos"
                >
                    <!-- IMAGEN DE FONDO -->
                    <img
                        src="/imagenes/fondorojo.png"
                        alt="Fondo compartir fotos"
                        class="absolute inset-0 w-full h-full object-cover"
                    />

                    <!-- Contenido de la card -->
                    <div
                        class="relative px-6 py-12 z-10 flex flex-col items-center gap-4"
                    >
                        <!-- IMAGEN -->
                        <div id="icono-camara">
                            <img
                                src="/imagenes/foto.png"
                                alt="Compartir foto"
                                class="w-20 h-20 object-contain icono-fotos"
                            />
                        </div>

                        <!-- TÍTULO -->
                        <div class="text-center" id="titulo-fotos">
                            <h2
                                class="font-crimson text-2xl font-bold uppercase tracking-widest text-[#B8960C]"
                            >
                                Subir Foto
                            </h2>
                        </div>

                        <!-- TEXTO DESCRIPTIVO -->
                        <div class="text-center" id="texto-fotos">
                            <p
                                class="font-crimson text-xl text-white leading-relaxed"
                            >
                                Ayuda a hacer eterno este día. Comparte tus
                                fotos y momentos especiales de nuestra boda,
                                para que todos podamos revivir esta celebración
                                una y otra vez.
                            </p>
                        </div>

                        <!-- BOTÓN -->
                        <div class="mt-2" id="boton-subir-fotos">
                            <a
                                href="https://photos.app.goo.gl/8ithKbNoJnyUuN2w5"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-block px-8 py-3 border-2 border-[#B8960C] text-[#B8960C] font-crimson text-base uppercase tracking-wider rounded-full hover:bg-[#B8960C] hover:text-[#3a0a0a] transition-all duration-300 font-semibold"
                            >
                                Compartir Fotos
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP - SOLO AL BAJAR                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            // Animación del botón decorativo
            gsap.fromTo(
                "#boton-decorativo-fotos",
                {
                    opacity: 0,
                    scale: 0,
                    rotation: -180,
                },
                {
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 1,
                    ease: "back.out(1.7)",
                    scrollTrigger: {
                        trigger: "#card-fotos",
                        start: "top 80%",
                        toggleActions: "play none none none",
                    },
                },
            );

            // Animación de la card
            gsap.fromTo(
                "#card-principal-fotos",
                {
                    opacity: 0,
                    y: 50,
                    scale: 0.95,
                },
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 1,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-fotos",
                        start: "top 80%",
                        toggleActions: "play none none none",
                    },
                },
            );

            // Animación del icono de cámara
            gsap.fromTo(
                "#icono-camara",
                {
                    opacity: 0,
                    scale: 0.5,
                    rotation: -10,
                },
                {
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 0.8,
                    ease: "back.out(1.7)",
                    scrollTrigger: {
                        trigger: "#card-fotos",
                        start: "top 80%",
                        toggleActions: "play none none none",
                    },
                },
            );

            // Animación del título
            gsap.fromTo(
                "#titulo-fotos",
                {
                    opacity: 0,
                    y: -20,
                },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    delay: 0.2,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-fotos",
                        start: "top 80%",
                        toggleActions: "play none none none",
                    },
                },
            );

            // Animación del texto
            gsap.fromTo(
                "#texto-fotos",
                {
                    opacity: 0,
                    y: 20,
                },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    delay: 0.4,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-fotos",
                        start: "top 80%",
                        toggleActions: "play none none none",
                    },
                },
            );

            // Animación del botón
            gsap.fromTo(
                "#boton-subir-fotos",
                { opacity: 0, y: 15, scale: 0.95 },
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 0.7,
                    delay: 0.6,
                    ease: "back.out(1.4)",
                    scrollTrigger: {
                        trigger: "#card-fotos",
                        start: "top 80%",
                        toggleActions: "play none none none",
                    },
                },
            );
        });
    }
</script>

<style>
    .icono-fotos {
        filter: brightness(0) saturate(100%) invert(72%) sepia(47%)
            saturate(700%) hue-rotate(5deg) brightness(97%) contrast(90%);
    }
</style>
