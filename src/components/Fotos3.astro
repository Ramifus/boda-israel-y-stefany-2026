<!-- ═══════════════════════════════════════════════════════════ --><!-- 📸 SECCIÓN: GALERÍA DE FOTOS 3                              --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full py-2 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto pt-4 pe-8 pb-4 ps-4 sm:px-6 lg:px-8">
        <!-- CONTENEDOR DE FOTOS -->
        <div class="relative w-full max-w-md mx-auto">
            <!-- FOTO GRANDE - IZQUIERDA/ARRIBA -->
            <div
                id="foto3a"
                class="relative w-full aspect-[4/5] rounded-lg shadow-lg overflow-hidden cursor-pointer transform transition-all duration-300 hover:scale-105 hover:shadow-xl"
                data-aos="fade-right"
                data-aos-duration="800"
                data-aos-delay="100"
            >
                <img
                    src="/imagenes/foto5.png"
                    alt="Foto 5"
                    class="w-full h-full object-cover"
                />
            </div>
            <!-- FOTO PEQUEÑA - DERECHA/ABAJO -->
            <div
                id="foto3b"
                class="absolute bottom-0 right-2 w-[45%] aspect-[4/5] rounded-lg shadow-lg overflow-hidden cursor-pointer translate-x-6 translate-y-6 transform transition-all duration-300 hover:scale-105 hover:shadow-xl"
                data-aos="fade-left"
                data-aos-duration="800"
                data-aos-delay="300"
            >
                <img
                    src="/imagenes/foto6.png"
                    alt="Foto 6"
                    class="w-full h-full object-cover"
                />
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🖼️ MODAL CON FONDO BLANCO ELEGANTE                         -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div
    id="modalFoto3"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4"
    style="opacity: 0; transition: opacity 0.3s ease; backdrop-filter: blur(10px);"
>
    <!-- FONDO BLANCO CON TOQUE PLOMO -->
    <div
        class="absolute inset-0 bg-gradient-to-br from-gray-50 via-gray-100 to-white opacity-98"
    >
    </div>

    <!-- CONTENIDO DEL MODAL -->
    <div class="relative max-w-5xl w-full z-10">
        <!-- BOTÓN CERRAR -->
        <button
            id="btnCerrar3"
            class="absolute -top-12 right-0 text-gray-700 hover:text-gray-900 transition-all duration-200 text-4xl font-bold hover:scale-110 hover:rotate-90 drop-shadow-lg"
            aria-label="Cerrar modal"
        >
            ✕
        </button>
        <!-- IMAGEN PRINCIPAL NÍTIDA -->
        <img
            id="modalImage3"
            src=""
            alt="Foto ampliada"
            class="w-full h-auto max-h-[90vh] object-contain rounded-lg shadow-xl"
        />
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 📜 JAVASCRIPT PARA EL MODAL Y ANIMACIONES                   -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
        const modal = document.getElementById("modalFoto3");
        const modalImage = document.getElementById("modalImage3");
        const foto3a = document.getElementById("foto3a");
        const foto3b = document.getElementById("foto3b");
        const btnCerrar = document.getElementById("btnCerrar3");

        function abrirModal(imageSrc) {
            modalImage.src = imageSrc;
            modal.classList.remove("hidden");
            modal.classList.add("flex");
            document.body.style.overflow = "hidden";
            setTimeout(() => {
                modal.style.opacity = "1";
            }, 10);
        }

        function cerrarModal() {
            modal.style.opacity = "0";
            setTimeout(() => {
                modal.classList.add("hidden");
                modal.classList.remove("flex");
                document.body.style.overflow = "auto";
            }, 300);
        }

        if (foto3a) {
            foto3a.addEventListener("click", function () {
                abrirModal("/imagenes/foto5.png");
            });
        }

        if (foto3b) {
            foto3b.addEventListener("click", function () {
                abrirModal("/imagenes/foto6.png");
            });
        }

        if (btnCerrar) {
            btnCerrar.addEventListener("click", function (e) {
                e.stopPropagation();
                cerrarModal();
            });
        }

        if (modal) {
            modal.addEventListener("click", function (e) {
                if (e.target === modal) {
                    cerrarModal();
                }
            });
        }

        if (modalImage) {
            modalImage.addEventListener("click", function (e) {
                e.stopPropagation();
            });
        }

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                cerrarModal();
            }
        });
    });
</script>
